{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WarCommand Tracker",
  "version": "0.3.1-beta",
  "identifier": "com.warcommand.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WarCommand Tracker",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#05080e",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../PRIVACY.md",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "version": "0.3.1"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGMDk2NDQ1NjA5RUJBMjUKUldRbHVwNWdSV1FKWHp3MDdDSkxiN2N6V2s5WDY1eDRmYzM4ZGc3TDRPN1ZqQjBGOHE5L1RtVHUK",
      "endpoints": [
        "https://github.com/zearkreast/WarRoom/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
