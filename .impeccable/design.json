  "narrative": {
    "northStar": "The War Table",
    "overview": "Companion structure on a holotable surface: near-black void, hairline square panels, uppercase extended display type, one hot yellow and faction colour as identity. An Operate surface tuned for a second screen during play.",
    "keyCharacteristics": [
      "Hatch-striped panel headers",
      "Tick-gapped faction meters",
      "Glowing Regions map",
      "One yellow per view",
      "Square corners and hairline borders"
    ],
    "rules": [
      {
        "name": "One Yellow",
        "body": "The CTA yellow marks one primary thing per view: the action, the focus, or the Major Order.",
        "section": "colors"
      },
      {
        "name": "Identity, Not Decoration",
        "body": "Faction colour always means who owns or attacks something, with an emblem beside it.",
        "section": "colors"
      },
      {
        "name": "Glow Is Data",
        "body": "Only meters, arcs, map contours and planet halos glow.",
        "section": "elevation"
      },
      {
        "name": "Two Faces",
        "body": "Archivo at 125% for names and titles; Chakra Petch for everything else.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep every live number covered by the status strip's freshness state.",
      "Do split mixed-unit charts into stacked charts on one time axis."
    ],
    "donts": [
      "Don't add kickers above headings.",
      "Don't round corners or use glass away from the map.",
      "Don't use dual-axis charts or categorical hues beyond the four factions."
    ]
