# WarRoom collector config. Copy to collector/.env and fill in.

# Supabase project URL (Project Settings → API).
SUPABASE_URL=

# Secret key (Project Settings → API Keys → "Secret keys", starts with sb_secret_).
# It bypasses row-level security: keep it on the server, never in the app.
SUPABASE_SECRET_KEY=

# Sent to api.helldivers2.dev on every request (both are required by the API).
SUPER_CLIENT=warcommand-tracker
# An email or project link the API maintainers can reach you at.
SUPER_CONTACT=
